# Copy to .env.local for local overrides. On Vercel, set these in Project -> Settings -> Environment Variables.

# Backend origin. Leave unset to use the /zenex-api proxy (Vite dev proxy locally, vercel.json rewrite on Vercel).
# VITE_API_URL=https://api-testnet.zenex.trade

# The six competitors as one JSON array. avatar is a public URL or a path under public/ (e.g. /avatars/ben.png).
# Vercel's env editor takes the whole line as the value; keep it on one line.
# VITE_COMPETITORS=[{"address":"GAAA...","name":"ben","avatar":"https://cdn.discordapp.com/avatars/123/abc.png"},{"address":"CBBB...","name":"alice","avatar":"/avatars/alice.png"}]
